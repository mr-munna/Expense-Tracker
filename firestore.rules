rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: uid
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - email: string (required) - User email
    //   - displayName: string (optional) - User display name
    //   - role: string (required) - 'super_admin', 'admin', or 'member'
    //   - createdAt: string (optional) - ISO date string
    //
    // Collection: payments, expenses, bills
    // Fields:
    //   - id: string (required)
    //   - createdBy: string (optional) - UID of the creator
    //   - [other fields as defined in blueprint]
    //
    // Collection: settings
    // Document ID: 'pdf' or 'tomorrowWork'
    // Fields:
    //   - [map of settings]
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isAuthenticated() && (
        getUserData().isApproved == true || 
        (request.auth.token.email == "bijoymahmudmunna@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'super_admin' || 
        (request.auth.token.email == "bijoymahmudmunna@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isAdmin() {
      return isApproved() && (getUserData().role == 'admin' || isSuperAdmin());
    }

    function isMember() {
      return isApproved() && (getUserData().role == 'member' || isAdmin());
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.role in ['super_admin', 'admin', 'member'] &&
             data.email is string &&
             data.uid is string;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if isAuthenticated();
      // Only super_admin can create/update roles and isApproved status. 
      // Users can create their own profile initially if it doesn't exist, but only as 'member' and 'isApproved: false' (unless default super_admin).
      allow create: if isAuthenticated() && request.auth.uid == uid && (
        (request.resource.data.role == 'member' && request.resource.data.isApproved == false) || 
        (request.auth.token.email == "bijoymahmudmunna@gmail.com" && request.resource.data.role == 'super_admin' && request.resource.data.isApproved == true)
      );
      allow update: if isSuperAdmin() || (
        isAuthenticated() && request.auth.uid == uid && 
        request.resource.data.role == resource.data.role &&
        request.resource.data.isApproved == resource.data.isApproved
      );
      allow delete: if isSuperAdmin();
    }

    match /payments/{id} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
    }

    match /expenses/{id} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
    }

    match /bills/{id} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isAdmin();
    }

    match /quotations/{id} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isAdmin();
    }

    match /collectedBills/{id} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
    }

    match /personalReceivedMoney/{id} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isAdmin() || (isMember() && (!("createdBy" in resource.data) || resource.data.createdBy == request.auth.uid));
    }

    match /personalGivenMoney/{id} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isAdmin() || (isMember() && (!("createdBy" in resource.data) || resource.data.createdBy == request.auth.uid));
    }

    match /project_list/{id} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    match /meetings/{id} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if isMember();
      allow write: if (id == 'tomorrowWork' && isMember()) || isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
